# Copy to .env and fill in. NEVER commit .env.

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# --- LLM (Anthropic) ---
ANTHROPIC_API_KEY=
# Any current Claude model id. Sonnet is the cost/quality default; Haiku is cheaper, Opus is stronger.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Speaker diarization (optional) ---
# Hugging Face token; you must also accept the terms of pyannote/speaker-diarization-community-1
# at https://huggingface.co/pyannote/speaker-diarization-community-1 . Leave empty to disable.
HF_TOKEN=

# --- Paths ---
# Host path of the Obsidian vault (used by docker-compose to mount it). Windows example:
#   VAULT_HOST_PATH=C:/Users/you/Vaults/company-kb
VAULT_HOST_PATH=./tmp-vault
# Paths as seen by the bot process. Inside Docker these are overridden by docker-compose.yml.
VAULT_PATH=./tmp-vault
DATA_PATH=./data
INBOX_PATH=./inbox
MODELS_PATH=./models
CONFIG_PATH=./config.yaml

# --- Vault git (optional) ---
# Commit after every ingest (requires the vault to be a git repo).
VAULT_GIT_COMMIT=true
# Push after every commit.
VAULT_GIT_PUSH=false
# Remote URL applied at startup. For pushing from inside Docker use HTTPS + a fine-grained PAT:
#   https://<username>:<token>@github.com/<owner>/<repo>.git
VAULT_GIT_REMOTE_URL=

# --- Transcription ---
# faster-whisper model: tiny | base | small | medium | large-v3 | distil-large-v3
WHISPER_MODEL=large-v3
# cuda | cpu | auto
WHISPER_DEVICE=auto
# int8_float16 (fast, ~2.5GB VRAM) | float16 | int8 (cpu)
WHISPER_COMPUTE_TYPE=int8_float16

# --- Misc ---
LOG_LEVEL=INFO
# Poll interval (seconds) for the inbox drop folder. Polling is required on Windows/Docker bind mounts.
INBOX_POLL_SECONDS=10
